flowchart TB
    subgraph ERP["ERP"]
        A1([Поставка оформлена]) --> A2[POST /api/v1/receivings]
    end
    subgraph SYS["SimpleWMS"]
        S1{Номер уже загружен?<br/>Поставщик и товары есть?}
        S2[Накладная «В ожидании»]
        S4[Партия + остаток в зоне приёмки<br/>движение «Приёмка»]
        S6[Накладная «Завершена»]
        S7[Данные для выгрузки в ERP<br/>GET /api/v1/receivings]
    end
    subgraph STK["Кладовщик"]
        K1[Начать приёмку]
        K2[Сверить строку: факт, срок годности,<br/>при необходимости — ячейка]
        K3{Все строки<br/>приняты?}
        K4[Завершить приёмку]
        K5[Печать ТОРГ-12]
    end
    A2 --> S1
    S1 -- "нет: 409 / 404" --> A3([Ошибка в ответе ERP])
    S1 -- да --> S2 --> K1 --> K2 --> S4 --> K3
    K3 -- нет --> K2
    K3 -- да --> K4 --> S6 --> S7
    S6 --> K5
