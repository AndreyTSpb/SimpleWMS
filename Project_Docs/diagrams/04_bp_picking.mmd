flowchart TB
    subgraph ERP["ERP / Менеджер"]
        E1([Заказ клиента]) --> E2[POST /api/v1/orders<br/>или ручное создание]
    end
    subgraph SYS["SimpleWMS"]
        S1[Резерв по FEFO: ближайший срок первым,<br/>без срока — последними, просроченные — нет]
        S2{Хватает<br/>остатка?}
        S3[«Частично зарезервирован»]
        S4[«Зарезервирован»]
        S6[Маршрут сборки по резервам<br/>в порядке обхода ячеек; заказ «В сборке»]
        S8[Ячейка → зона отгрузки<br/>движение «Сборка», резерв снят]
        S9{Все строки<br/>собраны?}
        S10[Заказ «Собран»]
    end
    subgraph MGR["Менеджер"]
        M1[Дорезервировать после поступления]
        M2[Передать в сборку]
    end
    subgraph STK["Кладовщик"]
        K1[Взять маршрут в работу,<br/>печать сборочного листа]
        K2[Собрать строку, указать<br/>фактическое количество]
    end
    E2 --> S1 --> S2
    S2 -- нет --> S3 --> M1 --> S1
    S2 -- да --> S4 --> M2 --> S6 --> K1 --> K2 --> S8 --> S9
    S9 -- нет --> K2
    S9 -- да --> S10
