# Скопировать в .env и при необходимости изменить.
# Файл .env читают docker compose и приложение при локальном запуске (spring.config.import).

# ---------- Локальная разработка (gradlew bootRun) ----------
# Профиль Spring: dev | prod (при локальном запуске по умолчанию dev)
SPRING_PROFILES_ACTIVE=dev

# ---------- PostgreSQL ----------
# DB_HOST — для bootRun; приложение в контейнере подключается к сервису db само
DB_HOST=localhost
# Порт PostgreSQL на компьютере (внутри Docker всегда 5432)
DB_PORT=5432
DB_NAME=wms
DB_USER=admin
DB_PASSWORD=password

# ---------- REST API ----------
# Ключ доступа ERP (заголовок X-API-Key). В профиле dev по умолчанию dev-api-key.
# В профиле prod обязателен: приложение не запустится с пустым ключом. Замените на свой!
WMS_API_KEY=dev-api-key

# ---------- Приложение в контейнере (docker compose --profile app up -d --build) ----------
# Профили: prod — только справочные данные; prod,demo — плюс демо-товары, ячейки, пользователи manager/storekeeper
APP_PROFILES=prod
# Порт приложения на компьютере
APP_PORT=8080
# Наименование склада в печатных формах
WMS_COMPANY_NAME=Склад SimpleWMS
# Память JVM
JAVA_OPTS=-Xms256m -Xmx512m

# После первого входа обязательно смените пароль admin (Администрирование → Пользователи).
