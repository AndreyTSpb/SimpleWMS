# Скопировать в .env и при необходимости изменить.
# Файл .env читают и docker compose, и приложение (spring.config.import).

# Профиль Spring: dev | prod (переменная окружения; при локальном запуске по умолчанию dev)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wms
DB_USER=admin
DB_PASSWORD=password
